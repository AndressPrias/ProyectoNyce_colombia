<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="831.0" prefWidth="852.0" spacing="20.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RegistrarMuestraController">
   <padding>
      <Insets bottom="24.0" left="30.0" right="30.0" top="30.0" />
   </padding>

   <children>
      <VBox spacing="6.0">
         <children>
            <Text text="Registrar Nueva Muestra">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Text>
            <Text text="Complete la informacion de la muestra y cargue la imagen del producto.">
               <font>
                  <Font size="14.0" />
               </font>
            </Text>
         </children>
      </VBox>

      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox maxWidth="1.7976931348623157E308" prefWidth="430.0" spacing="14.0" style="-fx-background-color: white; -fx-border-radius: 5; -fx-padding: 15; -fx-background-radius: 5;" HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Datos de la Muestra" />
                  <Label style="-fx-font-weight: bold;" text="Descripcion" />
                  <TextArea fx:id="txtDescripcion" maxWidth="1.7976931348623157E308" prefHeight="120.0" promptText="Ingrese la descripcion de la muestra..." VBox.vgrow="ALWAYS" />
                  <Label style="-fx-font-weight: bold;" text="Rotulo Cliente" />
                  <TextField fx:id="txtRotuloCliente" maxWidth="1.7976931348623157E308" promptText="Rotulo Cliente" />
                  <Label style="-fx-font-weight: bold;" text="Cantidad" />
                  <TextField fx:id="txtCantidad" maxWidth="1.7976931348623157E308" promptText="Cantidad" />
                  <Label style="-fx-font-weight: bold;" text="Estado" />
                  <ComboBox fx:id="comboEstado" maxWidth="1.7976931348623157E308" promptText="Seleccione un estado..." />
                  <Label style="-fx-font-weight: bold;" text="Fecha de Recepcion" />
                  <DatePicker fx:id="fechaRecepcion" maxWidth="1.7976931348623157E308" />
                  <Label style="-fx-font-weight: bold;" text="Ubicacion / Estante" />
                  <TextField fx:id="txtUbicacion" maxWidth="1.7976931348623157E308" promptText="Ubicacion / Estante" />
               </children>
            </VBox>

            <VBox maxHeight="1.7976931348623157E308" prefWidth="340.0" spacing="14.0" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-border-radius: 5; -fx-background-radius: 5;">
               <children>
                  <Label text="Imagen del Producto" />
                  <ImageView fx:id="imgProducto" fitHeight="420.0" fitWidth="310.0" preserveRatio="true" style="-fx-border-color: #cccccc; -fx-border-width: 2; -fx-border-style: dashed" VBox.vgrow="ALWAYS" />
                  <Button fx:id="btnSubirImagen" maxWidth="1.7976931348623157E308" onAction="#SubirImagen" text="Seleccionar imagen" />
                  <Label style="-fx-font-size: 10" text="Formatos permitidos: JPG, PNG, JPEG" />
                  <Label style="-fx-font-size: 10" text="Tamano maximo: 5MB" />
               </children>
            </VBox>
         </children>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Button fx:id="btnLimpiar" onAction="#limpiarCampos" prefHeight="36.0" prefWidth="79.0" text="Limpiar" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCancelar" onAction="#cerrarVentana" prefHeight="36.0" prefWidth="79.0" text="Cancelar" />
            <Button fx:id="btnGuardarMuestra" onAction="#registrarMuestra" prefHeight="36.0" prefWidth="130.0" style="-fx-background-color: #009180; -fx-text-fill: white;" text="Guardar Muestra" />
         </children>
      </HBox>
   </children>
</VBox>
