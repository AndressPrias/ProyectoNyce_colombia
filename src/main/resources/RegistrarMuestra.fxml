<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" prefHeight="796.0" prefWidth="1184.0" spacing="20.0" style="-fx-background-color: #f5f5f5;" stylesheets="@css/registrar-muestra.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RegistrarMuestraController">
   <padding>
      <Insets bottom="24.0" left="30.0" right="30.0" top="30.0" />
   </padding>

   <children>
      <VBox spacing="6.0">
         <children>
            <Text fill="#0a4d4a" text="Registrar nueva muestra">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Text>
            <Text text="Complete la información de la muestra y cargue la imagen del producto.">
               <font>
                  <Font size="14.0" />
               </font>
            </Text>
         </children>
      </VBox>

      <HBox alignment="TOP_CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox alignment="TOP_CENTER" maxWidth="630.0" prefHeight="677.0" prefWidth="630.0" spacing="14.0" style="-fx-background-color: white; -fx-border-radius: 5; -fx-padding: 15; -fx-background-radius: 5;">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="17.0" prefWidth="624.0" style="-fx-font-weight: bold;" text="Datos de la muestra" textAlignment="CENTER" textFill="#0a4d4a">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin></Label>
                  <VBox maxWidth="600.0" prefWidth="600.0" spacing="10.0">
                     <Label style="-fx-font-weight: bold;" text="Descripción Muestra *" textFill="#0a4d4a" />
                     <TextField fx:id="txtDescripcion" maxWidth="1.7976931348623157E308"
                                promptText="Ingrese la descripción de la muestra..." />
                     <Label style="-fx-font-weight: bold;" text="Referencia Externa *" textFill="#0a4d4a" />
                     <TextField fx:id="txtRotuloCliente" maxWidth="1.7976931348623157E308"
                                promptText="Ingrese la referencia externa" />
                     <Label style="-fx-font-weight: bold;" text="Nombre del cliente" textFill="#0a4d4a" />
                     <TextField fx:id="txtNombreCliente" maxWidth="1.7976931348623157E308"
                                promptText="Nombre del cliente" />
                     <Label style="-fx-font-weight: bold;" text="Marca" textFill="#0a4d4a" />
                     <TextField fx:id="txtMarca" maxWidth="1.7976931348623157E308"
                                promptText="Marca de la muestra" />
                     <Label style="-fx-font-weight: bold;" text="Referencia" textFill="#0a4d4a" />
                     <TextField fx:id="txtReferencia" maxWidth="1.7976931348623157E308"
                                promptText="Referencia del producto" />
                     <Label style="-fx-font-weight: bold;" text="Estado *" textFill="#0a4d4a" />
                     <ComboBox fx:id="comboEstado" maxWidth="1.7976931348623157E308"
                               promptText="Seleccione un estado..." />
                     <Label style="-fx-font-weight: bold;" text="Fecha de ingreso" textFill="#0a4d4a" />
                     <DatePicker fx:id="fechaRecepcionPicker" maxWidth="1.7976931348623157E308" />
                     <Label style="-fx-font-weight: bold;" text="Ubicación" textFill="#0a4d4a" />
                     <TextField fx:id="txtUbicacion" maxWidth="1.7976931348623157E308"
                                promptText="Ubicación de la muestra" />
                     <Label style="-fx-font-weight: bold;" text="Observaciones" textFill="#0a4d4a" />
                     <TextArea fx:id="txtObservaciones" maxWidth="1.7976931348623157E308"
                               prefHeight="88.0" promptText="Ingrese observaciones de la muestra"
                               wrapText="true" />
                     <Label style="-fx-font-size: 11;" text="* Campos obligatorios" textFill="#d32f2f" />
                  </VBox>
               </children>
            </VBox>

            <VBox maxHeight="1.7976931348623157E308" prefWidth="340.0" spacing="14.0" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-border-radius: 5; -fx-background-radius: 5;">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Imagen del producto" textFill="#0a4d4a" />
                  <StackPane fx:id="zonaImagen" minHeight="390.0" prefHeight="420.0"
                             styleClass="image-drop-zone" VBox.vgrow="ALWAYS">
                     <children>
                        <ImageView fx:id="imgProducto" fitHeight="390.0" fitWidth="390.0"
                                   mouseTransparent="true" preserveRatio="true" smooth="true" />
                        <Label fx:id="lblIndicacionArrastre" alignment="CENTER"
                               mouseTransparent="true" styleClass="drop-instruction"
                               text="Arrastra una imagen aquí" wrapText="true"
                               StackPane.alignment="BOTTOM_CENTER">
                           <StackPane.margin>
                              <Insets bottom="14.0" left="14.0" right="14.0" />
                           </StackPane.margin>
                        </Label>
                     </children>
                  </StackPane>
                  <Button fx:id="btnSubirImagen" maxWidth="1.7976931348623157E308" onAction="#seleccionarImagen" styleClass="btn-icon" stylesheets="@css/botones.css" text="Seleccionar imagen" textFill="#0a4d4a" />
                  <Label style="-fx-font-size: 10" text="Formatos permitidos: JPG, PNG, JPEG" />
                  <Label style="-fx-font-size: 10" text="Tamaño máximo: 5 MB" />
                  <Label fx:id="txtInformativos" alignment="CENTER" contentDisplay="CENTER" prefHeight="17.0" prefWidth="308.0" textAlignment="CENTER" textFill="#f80202" />
               </children>
            </VBox>
         </children>
      </HBox>

      <HBox alignment="CENTER_LEFT" maxWidth="990.0" prefWidth="990.0" spacing="20.0">
         <children>
            <Button fx:id="btnLimpiar" onAction="#limpiarCampos" prefHeight="31.0" prefWidth="109.0" styleClass="btn-secondary" stylesheets="@css/botones.css" text="Limpiar" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCancelar" onAction="#cerrarVentana" prefHeight="31.0" prefWidth="107.0" styleClass="btn-secondary" stylesheets="@css/botones.css" text="Cancelar" />
            <Button fx:id="btnGuardarMuestra" onAction="#guardarMuestra" prefHeight="31.0" prefWidth="162.0" style="-fx-background-color: #009180; -fx-text-fill: white;" styleClass="btn-primary" stylesheets="@css/botones.css" text="Guardar Muestra" />
         </children>
      </HBox>
   </children>
</VBox>
