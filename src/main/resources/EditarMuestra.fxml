<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="831.0" prefWidth="852.0" spacing="20.0" style="-fx-background-color: #EEF2F2;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.EditarMuestraController">
    <padding>
        <Insets bottom="24.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <children>
        <VBox spacing="6.0">
            <children>
                <Text fill="#0a4d4a" text="Editar Muestra">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Text>
                <Text text="Actualice la información de la muestra">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Text>
            </children>
        </VBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox maxWidth="1.7976931348623157E308" prefWidth="430.0" spacing="14.0" style="-fx-background-color: white; -fx-border-radius: 5; -fx-padding: 15; -fx-background-radius: 5;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label alignment="CENTER" prefHeight="17.0" prefWidth="401.0" style="-fx-font-weight: bold;" text="Datos de la muestra" textFill="#0a4d4a" />
                        <Label style="-fx-font-weight: bold;" text="Descripción *" textFill="#0a4d4a" />
                  <TextField fx:id="txtDescripcion" promptText="Ingrese la descripción de la muestra..." />
                        <Label style="-fx-font-weight: bold;" text="ID rótulo del cliente *" textFill="#0a4d4a" />
                        <TextField fx:id="txtRotuloCliente" maxWidth="1.7976931348623157E308" promptText="Identificación del rótulo del cliente" />
                  <Label style="-fx-font-weight: bold;" text="Cliente" textFill="#0a4d4a" />
                  <TextField fx:id="txtNombreCliente" maxWidth="1.7976931348623157E308" promptText="Nombre del cliente" />
                  <Label style="-fx-font-weight: bold;" text="Marca *" textFill="#0a4d4a" />
                        <TextField fx:id="txtMarca" maxWidth="1.7976931348623157E308" promptText="Ingrese la marca de la muestra" />
                  <Label style="-fx-font-weight: bold;" text="Referencia *" textFill="#0a4d4a" />
                  <TextField fx:id="txtReferencia" maxWidth="1.7976931348623157E308" promptText="Ingrese la referencia de la muestra" />
                        <Label style="-fx-font-weight: bold;" text="Estado *" textFill="#0a4d4a" />
                        <ComboBox fx:id="comboEstado" maxWidth="1.7976931348623157E308" promptText="Seleccione un estado..." />
                        <Label style="-fx-font-weight: bold;" text="Fecha de recepción *" textFill="#0a4d4a" />
                        <DatePicker fx:id="fechaRecepcionPicker" maxWidth="1.7976931348623157E308" />
                        <Label style="-fx-font-weight: bold;" text="Ubicación" textFill="#0a4d4a" />
                  <TextField fx:id="txtUbicacion" maxWidth="1.7976931348623157E308" promptText="Ingrese la ubicación" />
                  <Label style="-fx-font-weight: bold;" text="Nombre del técnico asignado" textFill="#0a4d4a" />
                  <ComboBox fx:id="comboTecnico" maxWidth="1.7976931348623157E308" promptText="Seleccione un técnico" />
                  <Label style="-fx-font-size: 11;" text="* Campos obligatorios" textFill="#d32f2f" />
                    </children>
                </VBox>

                <VBox maxHeight="1.7976931348623157E308" prefWidth="340.0" spacing="14.0" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <children>
                        <Label text="Imagen del producto" textFill="#0a4d4a">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Label>
                        <ImageView fx:id="imgProducto" fitHeight="420.0" fitWidth="310.0" preserveRatio="true" style="-fx-border-color: #cccccc; -fx-border-width: 2; -fx-border-style: dashed" VBox.vgrow="ALWAYS" />
                        <Button fx:id="btnSubirImagen" maxWidth="1.7976931348623157E308" onAction="#seleccionarImagen" styleClass="btn-icon" stylesheets="@css/botones.css" text="Seleccionar imagen" textFill="#0a4d4a">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Button>
                        <Label style="-fx-font-size: 10" text="Formatos permitidos: JPG, PNG, JPEG" />
                        <Label style="-fx-font-size: 10" text="Tamaño máximo: 5 MB" />
                  <Label text="Número de informe (4 dígitos)" textFill="#0a4d4a">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtNumeroInforme" promptText="Ejemplo: 0304" />
                  <Label text="Número de cotización (4 dígitos)" textFill="#0a4d4a">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtNumeroCotizacion" promptText="Ejemplo: 0580" />
                  <Label text="Remisión" textFill="#0a4d4a">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtRemision" editable="false" focusTraversable="false" promptText="Se asigna al generar la remisión" style="-fx-background-color: #eef2f2; -fx-text-fill: #0a4d4a; -fx-font-weight: bold;" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <Button fx:id="btnLimpiar" onAction="#limpiarCampos" prefHeight="31.0" prefWidth="90.0" styleClass="btn-secondary" stylesheets="@css/botones.css" text="Limpiar" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCancelar" onAction="#cerrarVentana" prefHeight="31.0" prefWidth="111.0" styleClass="btn-secondary" stylesheets="@css/botones.css" text="Cancelar" />
                <VBox alignment="TOP_RIGHT" spacing="6.0">
                    <children>
                        <Button fx:id="btnActualizarMuestra" onAction="#actualizarMuestra" prefHeight="31.0" prefWidth="176.0" style="-fx-background-color: #009180; -fx-text-fill: white;" styleClass="btn-primary" stylesheets="@css/botones.css" text="Actualizar Muestra" />
                        <Label fx:id="lblMensaje" alignment="CENTER_RIGHT" maxWidth="260.0" textAlignment="RIGHT" textFill="red" visible="false" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
