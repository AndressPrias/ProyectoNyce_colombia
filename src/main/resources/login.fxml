<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="625.0" prefWidth="767.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.loginController">
   <children>
      <ImageView fitHeight="339.0" fitWidth="336.0" layoutX="29.0" layoutY="208.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@icons/logoNyce.png" />
         </image>
      </ImageView>
      <AnchorPane layoutX="394.0" layoutY="50.0" prefHeight="530.0" prefWidth="344.0" style="-fx-background-color: #c3c3c3; -fx-background-radius: 10;">
         <children>
            <Text fill="#e4090f" layoutX="125.0" layoutY="95.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Login" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="29.0" />
               </font>
            </Text>
            <Text layoutX="71.0" layoutY="170.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Usuario" />
            <Text layoutX="71.0" layoutY="252.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Contraseña" />
            <TextField fx:id="txtUsuario" layoutX="71.0" layoutY="174.0" onAction="#iniciarSesion" prefHeight="25.0" prefWidth="213.0" promptText="user name" />
            <PasswordField fx:id="txtPassword" layoutX="71.0" layoutY="256.0" onAction="#iniciarSesion" prefHeight="25.0" prefWidth="213.0" promptText="Pass word" />
            <Button layoutX="103.0" layoutY="342.0" mnemonicParsing="false" onAction="#iniciarSesion" prefHeight="43.0" prefWidth="149.0" style="-fx-background-color: #009180;" text="Iniciar" textFill="#f9f9f9" />
            <Label fx:id="txtOlvidoContraseña" layoutX="187.0" layoutY="291.0" text="Olvido contraseña?" />
            <Label fx:id="lblMensaje" layoutX="18.0" layoutY="395.0" prefHeight="17.0" prefWidth="310.0" text="textoInformativos" textFill="#f50707" visible="false" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
