<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox minHeight="900.0" minWidth="1280.0" prefHeight="900.0" prefWidth="1280.0" spacing="12.0" style="-fx-background-color: #EEF2F2; -fx-padding: 10 14 14 14;" stylesheets="@css/dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BuscarMuestrasController">
    <children>
        <VBox spacing="1.0">
            <Text fill="#0a4d4a" style="-fx-font-size: 21; -fx-font-weight: bold;" text="Buscar y gestionar muestras" />
            <Text style="-fx-font-size: 12;" text="Consulte y visualice las muestras registradas en el sistema." />
        </VBox>

        <VBox spacing="6.0" styleClass="search-panel">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@icons/filtrar.png" /></image>
                </ImageView>
                <TextField fx:id="txtBusquedaGeneral" maxWidth="1.7976931348623157E308" minHeight="46.0" onAction="#buscarMuestras" promptText="Buscar por código, descripción muestra, nombre del cliente, referencia externa, marca, estado, ubicación, fecha o cualquier valor..." styleClass="search-field-main" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>

        <VBox spacing="22.0" VBox.vgrow="ALWAYS">
            <HBox fx:id="vboxVistaMuestra" alignment="TOP_LEFT" minHeight="330.0" minWidth="0.0" prefHeight="340.0" spacing="16.0" styleClass="detail-panel">
                <StackPane fx:id="zonaImagenDetalle" minHeight="292.0" minWidth="292.0"
                           prefHeight="300.0" prefWidth="315.0" styleClass="detail-image-frame">
                    <ImageView fx:id="imgDetalle" fitHeight="288.0" fitWidth="305.0"
                               mouseTransparent="true" preserveRatio="true" smooth="true" />
                    <Label fx:id="lblIndicacionImagenDetalle" alignment="CENTER"
                           mouseTransparent="true" styleClass="detail-image-instruction"
                           text="Selecciona una muestra" wrapText="true"
                           StackPane.alignment="BOTTOM_CENTER">
                        <StackPane.margin>
                            <Insets bottom="10.0" left="10.0" right="10.0" />
                        </StackPane.margin>
                    </Label>
                </StackPane>

                <VBox minWidth="0.0" spacing="13.0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label minWidth="205.0" prefWidth="205.0" style="-fx-font-size: 20; -fx-font-weight: bold;" text="Detalle de la muestra" textFill="#0a4d4a" />
                        <VBox minWidth="150.0" spacing="2.0" styleClass="detail-highlight-status" HBox.hgrow="ALWAYS">
                            <Label styleClass="detail-highlight-title" text="ESTADO ACTUAL" />
                            <Label fx:id="lblDetalleEstado" maxWidth="1.7976931348623157E308" styleClass="detail-highlight-value-status" wrapText="true" />
                        </VBox>
                        <VBox minWidth="150.0" spacing="2.0" styleClass="detail-highlight-location" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblTituloDetalleUbicacion" styleClass="detail-highlight-title" text="UBICACION" />
                            <Label fx:id="lblDetalleUbicacion" maxWidth="1.7976931348623157E308" styleClass="detail-highlight-value-location" wrapText="true" />
                        </VBox>
                    </HBox>

                    <VBox spacing="10.0">
                        <HBox spacing="12.0">
                            <VBox minWidth="0.0" spacing="3.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="detail-label" text="ID" />
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <Label fx:id="lblDetalleCodigoInterno" maxWidth="1.7976931348623157E308"
                                           styleClass="detail-value-strong" textOverrun="ELLIPSIS" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnImprimirEtiqueta" accessibleText="Imprimir etiqueta DYMO"
                                            managed="false" minHeight="24.0" minWidth="24.0"
                                            onAction="#imprimirEtiqueta" prefHeight="24.0" prefWidth="24.0"
                                            styleClass="btn-print-label" visible="false">
                                        <tooltip><Tooltip text="Imprimir etiqueta en DYMO" /></tooltip>
                                        <graphic><ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true"><image><Image url="@icons/imprimirVerde.png" /></image></ImageView></graphic>
                                    </Button>
                                </HBox>
                            </VBox>
                            <VBox minWidth="0.0" spacing="3.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="detail-label" text="Fecha de ingreso" />
                                <Label fx:id="lblDetalleFecha" maxWidth="1.7976931348623157E308"
                                       styleClass="detail-value" textOverrun="ELLIPSIS" />
                            </VBox>
                            <VBox minWidth="0.0" spacing="3.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="detail-label" text="Nombre del cliente" />
                                <Label fx:id="lblDetalleCliente" maxWidth="1.7976931348623157E308"
                                       styleClass="detail-value" textOverrun="ELLIPSIS" />
                            </VBox>
                            <VBox minWidth="0.0" spacing="3.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="detail-label" text="Marca" />
                                <Label fx:id="lblDetalleMarca" maxWidth="1.7976931348623157E308"
                                       styleClass="detail-value" textOverrun="ELLIPSIS" />
                            </VBox>
                        </HBox>
                        <HBox spacing="12.0">
                            <VBox minWidth="0.0" spacing="3.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="detail-label" text="Técnico" />
                                <Label fx:id="lblDetalleTecnico" maxWidth="1.7976931348623157E308"
                                       styleClass="detail-value" textOverrun="ELLIPSIS" />
                            </VBox>
                            <VBox minWidth="0.0" spacing="3.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="detail-label" text="Responsable" />
                                <Label fx:id="lblDetalleResponsable" maxWidth="1.7976931348623157E308"
                                       styleClass="detail-value" textOverrun="ELLIPSIS" />
                            </VBox>
                            <VBox minWidth="0.0" spacing="3.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="detail-label" text="Cantidad" />
                                <Label fx:id="lblDetalleCantidad" maxWidth="1.7976931348623157E308"
                                       styleClass="detail-value-strong" textOverrun="ELLIPSIS" />
                            </VBox>
                            <VBox minWidth="0.0" spacing="3.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="detail-label" text="Informes" />
                                <Label fx:id="lblDetalleInforme" maxWidth="1.7976931348623157E308"
                                       styleClass="detail-value" wrapText="true" />
                            </VBox>
                            <VBox minWidth="0.0" spacing="3.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="detail-label" text="Cotizaciones" />
                                <Label fx:id="lblDetalleCotizacion" maxWidth="1.7976931348623157E308"
                                       styleClass="detail-value" wrapText="true" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <HBox alignment="TOP_LEFT" spacing="8.0">
                        <Label minWidth="155.0" prefWidth="155.0" styleClass="detail-label"
                               text="Descripción Muestra" />
                        <Label fx:id="lblDetalleDescripcion" maxWidth="1.7976931348623157E308"
                               minHeight="32.0" styleClass="detail-text-block" wrapText="true"
                               HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox alignment="TOP_LEFT" spacing="8.0">
                        <Label minWidth="155.0" prefWidth="155.0" styleClass="detail-label"
                               text="Observaciones" />
                        <Label fx:id="lblDetalleObservaciones" maxWidth="1.7976931348623157E308"
                               minHeight="32.0" styleClass="detail-text-block" wrapText="true"
                               HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <VBox alignment="TOP_CENTER" minWidth="170.0" prefHeight="300.0" prefWidth="170.0" spacing="8.0">
                    <Button fx:id="btnFinalizarEnsayos" managed="false" maxWidth="1.7976931348623157E308" minHeight="50.0" prefHeight="50.0" onAction="#finalizarEnsayos" styleClass="btn-ready-detail" stylesheets="@css/botones.css" text="Finalizar ensayos" textAlignment="CENTER" visible="false" wrapText="true">
                        <graphic><ImageView fitHeight="15.0" fitWidth="15.0" preserveRatio="true"><image><Image url="@icons/iconMuestraWhite.png" /></image></ImageView></graphic>
                    </Button>
                    <Button fx:id="btnEditarInformacion" maxWidth="1.7976931348623157E308" minHeight="50.0" prefHeight="50.0" onAction="#editarInformacion" styleClass="btn-primary-detail" stylesheets="@css/botones.css" text="Editar informacion" textAlignment="CENTER" wrapText="true">
                        <graphic><ImageView fitHeight="15.0" fitWidth="15.0" preserveRatio="true"><image><Image url="@icons/lapiz.png" /></image></ImageView></graphic>
                    </Button>
                    <Button fx:id="btnAsignarInformeCotizacion" maxWidth="1.7976931348623157E308" minHeight="50.0" prefHeight="50.0" onAction="#asignarInformeCotizacion" styleClass="btn-primary-detail" stylesheets="@css/botones.css" text="Asignar informe y/o&#10;cotización" textAlignment="CENTER" textOverrun="CLIP" wrapText="true">
                        <graphic><ImageView fitHeight="15.0" fitWidth="15.0" preserveRatio="true"><image><Image url="@icons/iconMuestraWhite.png" /></image></ImageView></graphic>
                    </Button>
                    <Button fx:id="btnAsignarTecnico" maxWidth="1.7976931348623157E308" minHeight="50.0" prefHeight="50.0" onAction="#asignarTecnico" styleClass="btn-primary-detail" stylesheets="@css/botones.css" text="Asignar tecnico" textAlignment="CENTER" wrapText="true">
                        <graphic><ImageView fitHeight="15.0" fitWidth="15.0" preserveRatio="true"><image><Image url="@icons/iconRegistraUsuarioWhite.png" /></image></ImageView></graphic>
                    </Button>
                    <Button fx:id="btnAlmacenarMuestra" maxWidth="1.7976931348623157E308" minHeight="50.0" prefHeight="50.0" onAction="#almacenarMuestra" styleClass="btn-primary-detail" stylesheets="@css/botones.css" text="Almacenar" textAlignment="CENTER" wrapText="true">
                        <graphic><ImageView fitHeight="15.0" fitWidth="15.0" preserveRatio="true"><image><Image url="@icons/iconMuestraWhite.png" /></image></ImageView></graphic>
                    </Button>
                    <Button fx:id="btnEliminarMuestra" maxWidth="1.7976931348623157E308" minHeight="50.0" prefHeight="50.0" onAction="#eliminarMuestra" styleClass="btn-danger-detail" stylesheets="@css/botones.css" text="Eliminar" textAlignment="CENTER" wrapText="true">
                        <graphic><ImageView fitHeight="15.0" fitWidth="15.0" preserveRatio="true"><image><Image url="@icons/basura.png" /></image></ImageView></graphic>
                    </Button>
                </VBox>
            </HBox>

            <TableView fx:id="tblResultados" maxHeight="1.7976931348623157E308" minHeight="220.0" prefHeight="260.0" styleClass="samples-table" VBox.vgrow="ALWAYS">
                <VBox.margin>
                    <Insets top="12.0" />
                </VBox.margin>
                <columns>
                    <TableColumn fx:id="colCodigoInterno" prefWidth="45.0" text="ID" />
                    <TableColumn fx:id="colDescripcion" prefWidth="145.0" text="Descripción Muestra" />
                    <TableColumn fx:id="colCantidad" prefWidth="75.0" text="Cantidad" />
                    <TableColumn fx:id="colRotulo" prefWidth="130.0" text="Referencia Externa" />
                    <TableColumn fx:id="colCliente" prefWidth="120.0" text="Nombre del cliente" />
                    <TableColumn fx:id="colMarca" prefWidth="70.0" text="Marca" />
                    <TableColumn fx:id="colReferencia" prefWidth="95.0" text="Referencia" />
                    <TableColumn fx:id="colEstado" prefWidth="75.0" text="Estado" />
                    <TableColumn fx:id="colFecha" prefWidth="115.0" text="Fecha de ingreso" />
                    <TableColumn fx:id="colUbicacion" prefWidth="90.0" text="Ubicacion" />
                    <TableColumn fx:id="colTecnico" prefWidth="75.0" text="Tecnico" />
                    <TableColumn fx:id="colInforme" prefWidth="145.0" text="Informes" />
                    <TableColumn fx:id="colCotizacion" prefWidth="160.0" text="Cotizaciones" />
                    <TableColumn fx:id="colRemision" prefWidth="115.0" text="Remision" />
                </columns>
            </TableView>
        </VBox>
    </children>
</VBox>
