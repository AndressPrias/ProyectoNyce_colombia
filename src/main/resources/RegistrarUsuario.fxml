         <children>
              <Text fill="WHITE" layoutX="44.0" layoutY="70.0" text="Registrar Usuario">
                  <font>
                      <Font name="System Bold" size="24.0" />
                  </font>
              </Text>
      
              <Button fx:id="btnRegistrar" layoutX="49.0" layoutY="339.0" onAction="#registrarUsuario" text="Registrar" />
              <PasswordField fx:id="txtPassword" layoutX="49.0" layoutY="277.0" prefWidth="200" promptText="Contraseña" />
            <ImageView fx:id="imgRegistrarUsuarioCargo" fitHeight="25.0" fitWidth="25.0" layoutX="22.0" layoutY="277.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@icons/iconRegistrarContra.png" />
               </image>
            </ImageView>
              <ComboBox fx:id="comboRol" layoutX="47.0" layoutY="194.0" prefWidth="200" />
