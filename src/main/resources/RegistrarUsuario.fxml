<AnchorPane prefHeight="451.0" prefWidth="381.0" style="-fx-background-color: #E6E6E6;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RegistrarUsuarioController">
    <children>
