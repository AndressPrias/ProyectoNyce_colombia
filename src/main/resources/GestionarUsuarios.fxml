<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<HBox spacing="22.0" style="-fx-background-color: #f5f5f5;" stylesheets="@css/dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.GestionarUsuariosController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <VBox spacing="14.0" HBox.hgrow="ALWAYS">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Text text="Gestionar Usuarios">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Text>
                  <Text text="Consulta, registra, actualiza y elimina usuarios del sistema." />
               </children>
            </VBox>
            <TableView fx:id="tblUsuarios" prefHeight="337.0" prefWidth="502.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                  <TableColumn fx:id="colNombre" prefWidth="260.0" text="Nombre" />
                  <TableColumn fx:id="colRol" prefWidth="170.0" text="Rol" />
               </columns>
            </TableView>
         </children>
      </VBox>

      <VBox maxWidth="360.0" minWidth="320.0" prefWidth="340.0" spacing="14.0" style="-fx-background-color: #009180; -fx-background-radius: 8; -fx-padding: 20;">
         <children>
            <Text fill="WHITE" text="Datos del Usuario">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Text>

            <VBox spacing="6.0">
               <children>
                  <Label text="Nombre" textFill="WHITE" />
                  <TextField fx:id="txtNombre" maxWidth="1.7976931348623157E308" promptText="Nombre de usuario" />
               </children>
            </VBox>

            <VBox spacing="6.0">
               <children>
                  <Label text="Rol" textFill="WHITE" />
                  <ComboBox fx:id="comboRol" maxWidth="1.7976931348623157E308" promptText="Seleccione el rol" />
               </children>
            </VBox>

            <VBox spacing="6.0">
               <children>
                  <Label text="Contraseña" textFill="WHITE" />
                  <PasswordField fx:id="txtPassword" maxWidth="1.7976931348623157E308" promptText="Nueva contraseña" />
               </children>
            </VBox>

            <VBox alignment="CENTER" spacing="12.0">
               <children>
                  <Label text="Foto de perfil" textFill="WHITE" />
                  <StackPane prefHeight="150.0" prefWidth="150.0" styleClass="avatar-preview">
                     <children>
                        <ImageView fx:id="imgFotoPerfil" fitHeight="138.0" fitWidth="138.0" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <Button fx:id="btnSeleccionarImagen" mnemonicParsing="false" onAction="#seleccionarImagen" styleClass="btn-avatar" text="Seleccionar Imagen" />
               </children>
            </VBox>

            <Label fx:id="lblMensaje" contentDisplay="CENTER" prefHeight="48.0" prefWidth="300.0" textAlignment="CENTER" textFill="#970909" visible="false" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font></Label>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button onAction="#salir" text="Salir" />
                  <Button onAction="#nuevoUsuario" text="Nuevo" />
                  <Button fx:id="btnGuardar" onAction="#guardarUsuario" text="Registrar" />
                  <Button onAction="#eliminarUsuario" style="-fx-background-color: #E4002B; -fx-text-fill: white;" text="Eliminar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
